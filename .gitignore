# Dependencies
node_modules/

# Builds
dist/
.vercel-out/
api/_bundle.js
api/_bundle.js.map
*.tsbuildinfo

# Environment / secrets — never commit these
.env
.env.*
!.env.example

# Vercel
.vercel/

# Logs
*.log

# OS
.DS_Store

# Local working copies of the claude.ai project docs, kept so an update can
# splice one section rather than rewrite the whole file. Not part of the app.
.docs/

# Scratch entry point tools/browser-test.mjs writes inside the frontend package
# so that esbuild resolves the same React the app does. Removed on a clean run;
# left behind by a crashed one.
artifacts/editly/.browser-test/

# Bundled beside the worker so bare specifiers resolve; see tools/motion-test.mjs
artifacts/worker/.motion-test/

# Bundled beside the API for the same reason; see tools/stock-test.mjs
artifacts/api-server/.stock-test/

# Upstream font downloads, cached by make-caption-faces.py. What is committed is
# the built face beside it, not the file it came from.
artifacts/worker/fonts/.sources/

# Python bytecode. One of these was committed by accident and travelled through a
# merge as a binary hunk that `git apply` refuses without a full index line — a
# build artefact that made a patch of this repository unappliable.
__pycache__/
*.pyc
