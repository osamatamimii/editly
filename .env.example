# ─── API server ──────────────────────────────────────────────────────────────

# PostgreSQL connection string. Use Supabase's *transaction pooler* (port 6543),
# not the direct host — serverless functions open many short-lived connections.
# Example: postgresql://editly_app.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase project URL. Access tokens are verified against this project's JWKS,
# so it must match the project the frontend signs in against.
# Example: https://<project-ref>.supabase.co
SUPABASE_URL=

# Browser origin allowed to call the API, in addition to localhost and Vercel
# preview URLs. Set this to your production domain.
# Example: https://editly-eta.vercel.app
APP_ORIGIN=

# Optional. Grants the API admin access to Storage so it can reclaim a deleted
# project's video files even if the browser never gets the chance to. Without
# it, cleanup falls back to the browser and orphaned objects are possible.
# This key bypasses row-level security — keep it out of the client bundle and
# out of version control.
SUPABASE_SERVICE_ROLE_KEY=

# Local API server port (local development only)
PORT=3001

# ─── Models (render worker only) ─────────────────────────────────────────────
# These belong to the worker, not to the API or the browser. Both are optional:
# without them the worker still cuts silence, reframes, adds motion and levels
# audio — it just says in the render notes what it could not do, rather than
# quietly dropping it.

# Speech recognition. Gives us captions, word-accurate cuts, and the timing that
# tells us where the speaker leaned on a word.
DEEPGRAM_API_KEY=
# Optional override. Defaults to nova-3.
DEEPGRAM_MODEL=

# Scene understanding — what the transcript cannot say: where the shot changed,
# what is on screen, which stretch must not be cut through.
GEMINI_API_KEY=
# Optional override. Defaults to gemini-flash-lite-latest.
GEMINI_MODEL=

# ─── The planner (API server) ────────────────────────────────────────────────
# Turns "make the intro punchier and caption it" into an edit plan. Optional:
# without it the API falls back to keyword matching, which is worse and honest
# about being worse. The model only ever chooses from operations that exist, and
# the reply the user reads is generated from those operations rather than by the
# model, so it cannot promise work the worker will not do.

OPENAI_API_KEY=
# Optional override. Defaults to gpt-5-mini.
OPENAI_PLANNER_MODEL=


# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# These are compiled into the client bundle and are safe to expose: the anon key
# only grants what your row-level security policies allow.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
